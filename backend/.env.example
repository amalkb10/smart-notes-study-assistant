# MongoDB Connection String (defaults to local MongoDB)
MONGO_URI=mongodb://localhost:27017
DB_NAME=smart_notes_db

# Google Gemini API Key (Optional: for live AI features, get from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq API Key (Optional alternative, get from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Server Port
PORT=8000
HOST=0.0.0.0
